# Sightline environment. Copy this file to BOTH:
#   .env              (repo root: tooling, migrations)
#   apps/web/.env     (web app and worker; the worker reads it via --env-file)
#
# The defaults below boot with no provider accounts at all (the stub provider).
# Swap in a real scraping provider when you want actual AI answers.

# --- required ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sightline
DEPLOYMENT_MODE=local
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

# Session cookie encryption. Generate one:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Encrypts provider credentials stored in the database. Generate one:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=
# During a key rotation, previous keys go here, comma-separated.
# APP_ENCRYPTION_KEY_OLD=

DISABLE_TELEMETRY=1

# Local development only: open the dashboard as a seeded dev admin.
# Never enable this on a shared or deployed instance.
# DEV_AUTO_LOGIN=1

# --- what to track ---
# No-account default: canned answers, useful for UI work.
SCRAPE_TARGETS=stub:stub
ONBOARDING_LLM_TARGET=stub:stub
TYPESAFE_API_KEY=stub

# Real setup, for example with Cloro:
# SCRAPE_TARGETS=chatgpt:cloro:online,google-ai-mode:cloro:online
# CLORO_API_KEY=
# Remove ONBOARDING_LLM_TARGET=stub:stub and set one direct LLM key below.
# Replace TYPESAFE_API_KEY=stub with a real key (or use OPENROUTER_API_KEY).

# --- direct LLM APIs ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# --- other scraping providers, if you use them ---
# SEARCHAPI_API_KEY=
# OLOSTEP_API_KEY=
# BRIGHTDATA_API_TOKEN=
# OXYLABS_USERNAME=
# OXYLABS_PASSWORD=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
